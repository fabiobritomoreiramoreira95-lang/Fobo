name: Compilar mod

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 8

      - name: Criar arquivos do mod
        run: |
          mkdir -p $HOME/mod && cd $HOME/mod
          echo '' | base64 -d > 'build.gradle'
          mkdir -p 'src/main/java/com/superespada'
          echo '' | base64 -d > 'src/main/java/com/superespada/ItemSuperEspada.java'
          mkdir -p 'src/main/java/com/superespada'
          echo '' | base64 -d > 'src/main/java/com/superespada/SuperEspadaMod.java'
          mkdir -p 'src/main/resources/assets/superespada/lang'
          echo 'aXRlbS5zdXBlcl9lc3BhZGEubmFtZT1TdXBlciBFc3BhZGEK' | base64 -d > 'src/main/resources/assets/superespada/lang/en_US.lang'
          mkdir -p 'src/main/resources/assets/superespada/lang'
          echo 'aXRlbS5zdXBlcl9lc3BhZGEubmFtZT1TdXBlciBFc3BhZGEK' | base64 -d > 'src/main/resources/assets/superespada/lang/pt_BR.lang'
          mkdir -p 'src/main/resources/assets/superespada/textures/items'
          echo '' | base64 -d > 'src/main/resources/assets/superespada/textures/items/super_espada.png'
          mkdir -p 'src/main/resources'
          echo 'WwogIHsKICAgICJtb2RpZCI6ICJzdXBlcmVzcGFkYSIsCiAgICAibmFtZSI6ICJTdXBlciBFc3BhZGEiLAogICAgImRlc2NyaXB0aW9uIjogIkFkaWNpb25hIHVtYSBlc3BhZGEgc3VwZXIgZm9ydGUgZSBpbmRlc3RydXRpdmVsLiIsCiAgICAidmVyc2lvbiI6ICIxLjAiLAogICAgIm1jdmVyc2lvbiI6ICIxLjcuMTAiLAogICAgImF1dGhvckxpc3QiOiBbIlZvY2UiXQogIH0KXQo=' | base64 -d > 'src/main/resources/mcmod.info'

      - name: Instalar Gradle 2.14.1
        run: |
          wget -q https://services.gradle.org/distributions/gradle-2.14.1-bin.zip -O /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /opt

      - name: Compilar
        run: |
          cd $HOME/mod
          /opt/gradle-2.14.1/bin/gradle setupCIWorkspace
          /opt/gradle-2.14.1/bin/gradle build

      - uses: actions/upload-artifact@v4
        with:
          name: SuperEspada-jar
          path: ~/mod/build/libs/*.jar
